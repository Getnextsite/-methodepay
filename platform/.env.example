# ---------------------------------------------------------------- required

# Postgres. Any provider works; Neon, Supabase and Railway all do.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/methodepay"

# 32 bytes, base64 or hex. Encrypts merchant secrets at rest: Stripe keys,
# Telegram tokens, licence codes, buyer gift-card codes.
#   openssl rand -base64 32
# Rotating this makes every stored secret unreadable, so keep a backup of it
# wherever you keep your other production secrets.
ENCRYPTION_KEY=""

# Signs nothing, but seeds session handling. 32+ random characters.
#   openssl rand -base64 32
SESSION_SECRET=""

# Where the dashboard lives.
APP_URL="http://localhost:3000"

# Where hosted checkouts live. Set this to a separate host in production
# (pay.yourdomain.com) so merchant checkouts never share an origin with the
# dashboard. Defaults to APP_URL.
CHECKOUT_URL="http://localhost:3000"

# ---------------------------------------------------------------- optional

# Outbound email: delivery receipts, refunds, renewal reminders. Without it
# the app still works and orders still settle — buyers just get no email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MethodePay <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Platform billing: what merchants pay YOU.
#
# Two providers are supported and FREEMIUS WINS when both are filled in. Pick
# one — running both means two systems able to set the same account tier.
# Leave both blank and plan gating still works; you just set tiers by hand.
# ---------------------------------------------------------------------------

# --- Option A: Freemius (hosted checkout, tax handling and customer portal) --
# Product id from the Freemius Developer Dashboard.
FREEMIUS_PRODUCT_ID=""
# The product SECRET key, from Developer Dashboard → Settings. Every inbound
# webhook is HMAC-SHA256 verified against it, so treat it like a Stripe secret.
FREEMIUS_SECRET_KEY=""
# One plan id per tier. A Freemius plan carries both its monthly and annual
# pricing, so there is no id per interval — the interval is a checkout param.
FREEMIUS_PLAN_STARTER=""
FREEMIUS_PLAN_PROFESSIONAL=""
FREEMIUS_PLAN_AGENCY=""
#
# In the Freemius dashboard, set:
#   Webhook URL      POST {APP_URL}/api/webhooks/freemius
#   Events           license.*, subscription.*, payment.created, payment.refund
#   Checkout return  {APP_URL}/dashboard/billing
#
# That return URL matters. Freemius webhooks carry no custom metadata, so the
# account is bound to its Freemius identity when the buyer lands back there in
# their own session. Without it, a first purchase can only be matched by the
# owner email on the account.

# --- Option B: your own Stripe account ---
# Entirely separate from the Stripe keys merchants paste in to take buyer
# payments.
PLATFORM_STRIPE_SECRET_KEY=""
# Webhook endpoint: POST {APP_URL}/api/webhooks/stripe/billing
# Events: checkout.session.completed, customer.subscription.*, invoice.payment_failed
PLATFORM_STRIPE_WEBHOOK_SECRET=""

# Price ids from your own Stripe product catalogue, one per tier and interval.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_AGENCY_MONTHLY=""
STRIPE_PRICE_AGENCY_YEARLY=""

# Bearer token for POST /api/cron/renewals. Unset disables the endpoint
# entirely rather than leaving it open.
#   openssl rand -hex 32
CRON_SECRET=""
