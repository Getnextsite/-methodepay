// MethodePay platform — multi-tenant hosted checkout.
//
// Every merchant-owned row carries accountId. Nothing is queried without an
// account scope; see src/lib/tenancy.ts for the single place that resolves it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

// Server-side sessions rather than bare JWTs: a lost laptop or a departed
// staff member has to be revocable without rotating a global secret.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
  @@map("memberships")
}

model Invite {
  id         String    @id @default(cuid())
  accountId  String
  email      String
  role       Role      @default(STAFF)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("invites")
}

// ---------------------------------------------------------------- tenant

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  AGENCY
}

model Account {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  planTier PlanTier @default(FREE)
  // A free account is a trial, not a forever tier. Null = never expires.
  trialEndsAt DateTime?
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships          Membership[]
  invites              Invite[]
  apiKeys              ApiKey[]
  subscription         BillingSubscription?
  products             Product[]
  orders               Order[]
  coupons              Coupon[]
  wallets              Wallet[]
  paymentMethods       PaymentMethodConfig[]
  manualMethods        ManualMethod[]
  checkoutProfile      CheckoutProfile?
  notificationSettings NotificationSettings?
  webhookEndpoints     WebhookEndpoint[]
  domains              Domain[]

  @@map("accounts")
}

model ApiKey {
  id         String    @id @default(cuid())
  accountId  String
  name       String
  // Shown in the UI so a key stays identifiable after the secret is gone.
  prefix     String    @unique
  keyHash    String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("api_keys")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model BillingSubscription {
  id                   String             @id @default(cuid())
  accountId            String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(INCOMPLETE)
  interval             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("billing_subscriptions")
}

// A merchant may point their own hostname at the hosted checkout.
model Domain {
  id          String    @id @default(cuid())
  accountId   String
  hostname    String    @unique
  verifyToken String
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("domains")
}

// ---------------------------------------------------------------- catalogue

enum ProductType {
  DIGITAL
  PHYSICAL
}

model Product {
  id          String      @id @default(cuid())
  accountId   String
  name        String
  slug        String
  description String?     @db.Text
  priceCents  Int         @default(0)
  currency    String      @default("USD")
  imageUrl    String?
  active      Boolean     @default(true)
  type        ProductType @default(DIGITAL)

  // Subscription length in days. 0 = one-off purchase, no expiry.
  durationDays Int @default(0)

  // Fulfilment
  thanksTitle       String?
  thanksMessage     String? @db.Text
  thanksRedirectUrl String?
  deliveryFileUrl   String?
  // Encrypted at rest: it is a bearer credential, like a licence key.
  deliveryAccessCodeEnc String? @db.Text

  // Physical goods
  manageStock      Boolean @default(false)
  stock            Int     @default(0)
  weightGrams      Int     @default(0)
  requiresShipping Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([accountId, slug])
  @@index([accountId, active])
  @@map("products")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id        String     @id @default(cuid())
  accountId String
  code      String
  type      CouponType @default(PERCENT)
  // PERCENT: whole percent (0-100). FIXED: minor units.
  value      Int       @default(0)
  usageLimit Int       @default(0)
  usageCount Int       @default(0)
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
  @@index([accountId, active])
  @@map("coupons")
}

model Wallet {
  id         String   @id @default(cuid())
  accountId  String
  coin       String
  network    String   @default("")
  address    String
  qrImageUrl String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, coin, network])
  @@index([accountId, active])
  @@map("wallets")
}

// One row per payment rail the merchant has touched. `config` holds the
// rail-specific fields; secrets inside it are encrypted and never serialised
// to the browser (see src/lib/gateway/registry.ts).
model PaymentMethodConfig {
  id          String   @id @default(cuid())
  accountId   String
  key         String
  enabled     Boolean  @default(false)
  label       String?
  description String?  @db.Text
  iconUrl     String?
  sortOrder   Int      @default(0)
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@index([accountId, enabled])
  @@map("payment_method_configs")
}

// Merchant-defined rails: M-Pesa, PIX, Orange Money, a local POS terminal.
model ManualMethod {
  id               String   @id @default(cuid())
  accountId        String
  slot             Int
  enabled          Boolean  @default(false)
  name             String   @default("")
  iconUrl          String?
  instructions     String?  @db.Text
  videoUrl         String?
  buttonLabel      String?
  buttonUrl        String?
  requireReference Boolean  @default(true)
  requiresGiftCard Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, slot])
  @@map("manual_methods")
}

// ---------------------------------------------------------------- checkout

enum CheckoutDesign {
  CLASSIC
  LITE
  STOREFRONT
  EXPRESS
  HERO
  TRUST
}

model CheckoutProfile {
  id        String         @id @default(cuid())
  accountId String         @unique
  design    CheckoutDesign @default(CLASSIC)

  // Branding
  logoUrl       String?
  logoMaxHeight Int     @default(36)
  colorPrimary  String  @default("#00ffa3")
  colorBgStart  String  @default("#0a0e1a")
  colorBgEnd    String  @default("#1a1030")
  colorText     String  @default("#ffffff")
  colorCardBg   String  @default("#10131c")
  fontFamily    String  @default("Inter")
  layoutWidth   Int     @default(1080)
  cardRadius    Int     @default(16)
  baseFontSize  Int     @default(16)
  customCss     String? @db.Text

  // Copy
  checkoutTitle    String?
  checkoutSubtitle String?
  privacyPolicyUrl String?
  termsUrl         String?

  // Trust block
  showTrustBadges Boolean @default(true)
  trustBadges     Json    @default("[]")
  guaranteeTitle  String  @default("100% Money Back Guarantee")
  guaranteeText   String? @db.Text
  guaranteeDays   Int     @default(30)
  testimonials    Json    @default("[]")

  // Buyer fields: { phone: "hidden" | "optional" | "required", ... }
  fieldVisibility Json @default("{}")
  customFields    Json @default("[]")

  // Order bump and post-purchase upsell
  bump   Json @default("{}")
  upsell Json @default("{}")

  // KYC pre-warning shown on on-ramp rails
  kycNoticeEnabled Boolean @default(true)
  kycNoticeMethods Json    @default("[]")
  kycNoticeText    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("checkout_profiles")
}

model NotificationSettings {
  id           String  @id @default(cuid())
  accountId    String  @unique
  storeName    String  @default("")
  supportEmail String  @default("")
  fromName     String?
  orderPrefix  String  @default("MP-")

  telegramBotTokenEnc String? @db.Text
  telegramChatId      String?

  notifyOnNewOrder Boolean  @default(true)
  notifyOnConfirm  Boolean  @default(true)
  notifyEmails     String[] @default([])

  // Buyer-facing confirmation channels ("whatsapp", "telegram", ...)
  confirmChannels Json    @default("[]")
  confirmWhatsapp String?
  confirmTelegram String?
  confirmMessage  String? @db.Text

  // Renewal reminders
  renewalsEnabled     Boolean @default(false)
  renewReminderDays   String  @default("7,3,1,0")
  renewSubject        String  @default("Your {product} expires in {days} days")
  renewExpiredSubject String  @default("Your {product} has expired")
  renewDiscountCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ---------------------------------------------------------------- orders

enum OrderStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  REFUNDED
  CANCELLED
  EXPIRED
}

enum RenewalState {
  NONE
  ACTIVE
  RENEWED
  EXPIRED
  CANCELLED
}

model Order {
  id        String @id @default(cuid())
  accountId String
  productId String

  // Human-quotable reference (MP-7F3K2Q). Buyers read this out on WhatsApp.
  ref String @unique
  // Unguessable handle for the buyer-facing pages; never a sequential id.
  nonce String @unique

  buyerName       String
  buyerEmail      String
  buyerPhone      String?
  buyerCountry    String?
  buyerState      String?
  buyerCity       String?
  buyerPostalCode String?
  buyerAddress1   String?
  buyerAddress2   String?
  buyerCompany    String?
  buyerNote       String? @db.Text

  amountCents   Int
  discountCents Int     @default(0)
  shippingCents Int     @default(0)
  currency      String  @default("USD")
  couponCode    String?

  status        OrderStatus @default(PENDING)
  paymentMethod String?
  // Buyer-supplied proof: MTCN, bank memo, PayPal txn id, chain TXID.
  paymentReference String?
  txid             String?
  payoutAddress    String?
  trackingAddress  String?

  // Gift-card codes are bearer credentials: encrypted, privileged-read only,
  // and erased the moment the order is marked paid.
  giftCardCodeEnc String? @db.Text
  giftCardCountry String?

  meta Json @default("{}")

  expiresAt        DateTime?
  deliveredAt      DateTime?
  serviceExpiresAt DateTime?
  renewalOfId      String?
  renewalState     RenewalState @default(NONE)
  remindersSent    String       @default("")

  shippingMethod  String?
  trackingNumber  String?
  trackingCarrier String?
  shippedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  events    OrderEvent[]
  renewalOf Order?       @relation("Renewal", fields: [renewalOfId], references: [id], onDelete: SetNull)
  renewals  Order[]      @relation("Renewal")

  @@index([accountId, status])
  @@index([accountId, createdAt])
  @@index([productId])
  @@index([serviceExpiresAt])
  @@index([buyerEmail])
  @@map("orders")
}

// Manual rails settle on a human judgement ("I saw the money land"), and that
// judgement is invisible once a chargeback arrives. Record who decided what,
// when, and on what evidence.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  note      String?  @db.Text
  actor     String   @default("system")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

// ---------------------------------------------------------------- webhooks

model WebhookEndpoint {
  id        String   @id @default(cuid())
  accountId String
  url       String
  secret    String
  events    String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([accountId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  endpointId   String
  event        String
  payload      Json
  status       String   @default("pending")
  responseCode Int?
  attempts     Int      @default(0)
  lastError    String?  @db.Text
  createdAt    DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@map("webhook_deliveries")
}

// Idempotency guard for inbound provider callbacks. A provider that retries a
// webhook three times must not mark an order paid three times.
model ProcessedEvent {
  id         String   @id @default(cuid())
  source     String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@map("processed_events")
}
